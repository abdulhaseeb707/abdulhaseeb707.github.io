---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Abdul Haseeb Khan" noindex>
  <section class="wrap missing">
    <p class="kicker">404</p>
    <h1>Nothing here.</h1>
    <p class="lead">The link may be old or have a typo.</p>
    <p class="actions">
      <a class="btn btn-ink" href="/">Go to the home page</a>
      <a class="btn" href="/cv/">See my CV</a>
    </p>
  </section>
</Base>

<style>
  .missing { padding-block: clamp(64px, 14vh, 140px); }
  h1 { font-size: var(--fs-hero); font-weight: 800; }
  .lead { margin-top: 14px; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
</style>
