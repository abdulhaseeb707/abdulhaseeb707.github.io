---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import { research as r, asset } from '../../lib/profile';

export function getStaticPaths() {
  return [{ params: { slug: r.slug } }];
}
---
<Base title={`${r.title} | Abdul Haseeb Khan`} description={r.tagline}>
  <article>
    <header class="block-green">
      <div class="wrap head">
        <a class="back" href="/#research"><Icon name="arrow-left" /> Back to the home page</a>
        <p class="status">{r.status}</p>
        <h1>{r.title}</h1>
        <p class="lead">{r.tagline}</p>
        <dl class="stats">
          {r.stats.map((s) => <div><dt>{s.figure}</dt><dd>{s.text}</dd></div>)}
        </dl>
      </div>
    </header>

    <div class="wrap body">
      <div class="text">
        {r.page.map((p) => <p class="lead">{p}</p>)}
        <p class="origin">{r.origin}</p>

        <ul class="links">
          {r.links.map((l, i) => (
            <li>
              <a class:list={['btn', i === 0 ? 'btn-ink' : '']} href={l.url} target="_blank" rel="noopener">
                {l.label} {l.note && <span class="small">{l.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="figs">
        {r.figures.map((f, i) => (
          <figure>
            <a class="js-lightbox" href={asset(f.src).src} data-gallery="figures" data-caption={f.caption}>
              <Image src={asset(f.src)} alt={f.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 560px, 92vw" />
            </a>
            <figcaption>{f.caption}</figcaption>
          </figure>
        ))}
      </div>

      <section class="box">
        <h2>The exact results</h2>
        <ul>{r.exact.map((e) => <li>{e}</li>)}</ul>
        <p class="small-note">These are associations, not causal effects. Working paper, not peer reviewed.</p>
      </section>

      <section class="box yellow">
        <h2>What I did</h2>
        <ul>{r.did.map((d) => <li>{d}</li>)}</ul>
        <ul class="tags">{r.tags.map((t) => <li class="tag">{t}</li>)}</ul>
      </section>
    </div>
  </article>
  <Lightbox />
</Base>

<style>
  .head { padding-block: clamp(28px, 5vw, 64px); }
  .back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  .status {
    display: inline-block;
    margin: 18px 0 14px;
    padding: 5px 12px;
    border: 1.5px solid currentColor;
    border-radius: var(--pill);
    font: 500 0.8rem/1.2 var(--mono);
  }
  h1 { font-size: var(--fs-h2); font-weight: 800; max-width: 22ch; }
  .lead { margin-top: 14px; max-width: 52ch; }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 28px 0 0;
    max-width: 760px;
  }
  .stats div { padding: 14px 16px; border: 2px solid var(--surface); border-radius: var(--radius-sm); }
  .stats dt { font: 800 2rem/1 var(--display); letter-spacing: -0.03em; }
  .stats dd { margin: 6px 0 0; font: 500 0.8rem/1.2 var(--mono); }

  .body {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .text { max-width: 760px; }
  .text .lead { margin-top: 0; margin-bottom: 1em; color: var(--ink-soft); }
  .origin { font-size: 0.95rem; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin-top: 22px; }
  .small { font: 400 0.75rem/1 var(--mono); opacity: 0.75; }

  .figs {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .figs figure {
    padding: 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .figs a { display: block; cursor: zoom-in; }
  .figs img { width: 100%; border-radius: 8px; }
  .figs figcaption { margin-top: 10px; font-size: 0.92rem; color: var(--ink-soft); }

  .box {
    padding: clamp(20px, 3vw, 32px);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--mint);
    max-width: 920px;
  }
  .box.yellow { background: var(--yellow); }
  .box h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 14px; }
  .box ul:not(.tags) { padding-left: 20px; display: grid; gap: 8px; }
  .box .tags { margin-top: 18px; }
  .small-note { margin-top: 14px; font: 400 0.82rem/1.4 var(--mono); }
</style>
