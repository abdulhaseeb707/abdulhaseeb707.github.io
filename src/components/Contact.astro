---
import Icon from './Icon.astro';
import { contact, site } from '../lib/profile';
---
<section class="block-coral" id="contact" aria-labelledby="contact-title">
  <div class="wrap section contact">
    <p class="kicker">Contact</p>
    <h2 id="contact-title">Say hello.</h2>
    <p class="lead">I'm open to research and analyst roles, scholarships and freelance work.</p>

    <div class="email-row">
      <a class="email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <button class="btn copy" type="button" data-copy={contact.email}><Icon name="copy" /> <span>Copy</span></button>
    </div>

    <ul class="links">
      <li><a class="btn btn-ink" href={site.cvPage}>See my CV <Icon name="arrow-right" /></a></li>
      <li><a class="btn" href={contact.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin" /> LinkedIn</a></li>
      <li><a class="btn" href={contact.github} rel="me noopener" target="_blank"><Icon name="github" /> GitHub</a></li>
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    const label = button.querySelector('span')!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Press Ctrl+C';
        const range = document.createRange();
        range.selectNodeContents(document.querySelector('.email')!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
      setTimeout(() => (label.textContent = 'Copy'), 2400);
    });
  });
</script>

<style>
  h2 { font-size: calc(var(--fs-hero) * 1.05); font-weight: 800; letter-spacing: -0.04em; }
  .lead { margin-top: 14px; max-width: 40ch; }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: clamp(24px, 4vh, 40px);
  }
  .email {
    font: 700 clamp(1.25rem, 3.2vw, 2.4rem)/1.1 var(--display);
    letter-spacing: -0.02em;
    text-decoration-thickness: 3px;
    overflow-wrap: anywhere;
  }
  .links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin-top: 26px; }
</style>
