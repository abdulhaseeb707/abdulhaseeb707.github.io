---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { person, site, asset } from '../lib/profile';

// slight, hand-placed tilts for the polaroids
const tilt = [-3, 4, -6, 2.5, -1.5];
---
<section class="hero wrap" aria-labelledby="hello">
  <div class="hero-text">
    <p class="kicker">{person.role} · {person.location}</p>
    <h1 id="hello">Hi, I'm <span class="mark">{person.shortName}</span>.</h1>
    <p class="lead">{person.line}</p>

    <div class="actions">
      <a class="btn btn-ink" href={site.cvPage}>See my CV <Icon name="arrow-right" /></a>
      <a class="btn" href={site.cvFile} download><Icon name="download" /> Download PDF</a>
    </div>

    {
      person.tags.length > 0 && (
        <ul class="tags tilt">
          {person.tags.map((t) => (
            <li class={`tag ${t.color}`}>{t.text}</li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="stack-wrap">
    <div class="stack" data-stack>
      {
        person.photos.map((p, i) => (
          <figure class="polaroid" style={`--r:${tilt[i % tilt.length]}deg; --i:${i}`} data-index={i}>
            <Image
              src={asset(p.src)}
              alt={p.alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1000px) 360px, 70vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
    {person.photos.length > 1 && (
      <button class="shuffle" type="button" hidden>
        Next photo <span class="count">1 / {person.photos.length}</span>
      </button>
    )}
  </div>
</section>

<script>
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const button = document.querySelector<HTMLButtonElement>('.shuffle');
  if (stack && button) {
    const cards = [...stack.querySelectorAll<HTMLElement>('.polaroid')];
    const count = button.querySelector('.count')!;
    let order = cards.map((_, i) => i);
    let busy = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const paint = () => {
      order.forEach((cardIndex, depth) => cards[cardIndex].style.setProperty('--i', String(depth)));
      count.textContent = `${order[0] + 1} / ${cards.length}`;
    };
    const next = () => {
      if (busy) return;
      busy = true;
      const top = cards[order[0]];
      top.classList.add('leaving');
      setTimeout(() => {
        order = [...order.slice(1), order[0]];
        paint();
        top.classList.remove('leaving');
        busy = false;
      }, reduce ? 0 : 320);
    };
    button.hidden = false;
    button.addEventListener('click', next);
    stack.addEventListener('click', next);
    paint();
  }
</script>

<style>
  .hero {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(36px, 7vh, 88px) clamp(48px, 8vh, 96px);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      min-height: min(calc(100svh - var(--header)), 860px);
    }
  }

  h1 {
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .mark {
    display: inline-block;
    padding: 0 0.12em;
    margin: 0 -0.04em;
    background: var(--yellow);
    border-radius: 0.12em;
    transform: rotate(-1.5deg);
  }
  .lead {
    max-width: 30ch;
    margin-top: clamp(16px, 2.5vh, 26px);
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(22px, 3.5vh, 36px);
  }
  .tags { margin-top: clamp(22px, 3.5vh, 34px); }

  /* the polaroid stack */
  .stack-wrap {
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .stack {
    position: relative;
    width: min(360px, 74vw, calc((100svh - var(--header) - 170px) * 0.7));
    min-width: 220px;
    aspect-ratio: 4 / 5.2;
    cursor: pointer;
  }
  .polaroid {
    position: absolute;
    inset: 0;
    padding: 10px 10px 0;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 6px;
    transform: rotate(var(--r)) translate(calc(var(--i) * 7px), calc(var(--i) * -5px));
    z-index: calc(20 - var(--i));
    transition: transform 0.32s ease, opacity 0.32s ease;
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: 3px;
    background: var(--paper);
  }
  .polaroid figcaption {
    padding: 10px 4px 0;
    font: 500 0.85rem/1.2 var(--mono);
    text-align: center;
  }
  .polaroid.leaving {
    transform: rotate(14deg) translate(55%, -6%);
    opacity: 0;
  }
  .shuffle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border: 2px solid var(--ink);
    border-radius: var(--pill);
    background: var(--paper);
    font: 600 0.88rem/1 var(--sans);
    cursor: pointer;
  }
  .shuffle:hover { background: var(--mint); }
  .count { font-family: var(--mono); font-weight: 400; color: var(--muted); }

  @media (max-width: 899px) {
    .hero { padding-top: 32px; }
    .stack { width: min(300px, 72vw); }
  }
</style>
