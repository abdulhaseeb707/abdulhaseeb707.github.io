---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { person, highlights, contact, site, asset } from '../lib/profile';

const [headline, ...rest] = person.intro;
const hero = person.hero;
---
<section class="opening wrap" aria-labelledby="opening-title">
  <div class="opening-text">
    <p class="label kicker">{person.tagline}</p>
    <h1 id="opening-title">{headline}</h1>
    {rest.map((p) => <p class="intro">{p}</p>)}

    <div class="actions">
      <a class="button primary" href={site.cvFile} download>
        <Icon name="download" /> Download my CV
      </a>
      <a class="button" href="#story">
        Read my story <Icon name="arrow-down" />
      </a>
    </div>
    <p class="cv-note">A two-page PDF, generated from this website. Updated {site.built}.</p>

    <ul class="elsewhere">
      <li><a href={contact.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin" /> LinkedIn</a></li>
      <li><a href={contact.github} rel="me noopener" target="_blank"><Icon name="github" /> GitHub</a></li>
      <li><a href={`mailto:${contact.email}`}><Icon name="mail" /> {contact.email}</a></li>
    </ul>
  </div>

  {
    hero ? (
      <figure class="photo">
        <Image
          src={asset(hero.src)}
          alt={hero.alt}
          widths={[360, 540, 760, 960]}
          sizes="(min-width: 1000px) 420px, (min-width: 640px) 60vw, 92vw"
          loading="eager"
          fetchpriority="high"
        />
        {hero.caption && <figcaption>{hero.caption}</figcaption>}
      </figure>
    ) : (
      <figure class="photo">
        <Image src={asset(person.portrait)} alt={`Portrait of ${person.name}`} widths={[280, 413]} sizes="300px" loading="eager" />
      </figure>
    )
  }
</section>

{
  highlights.length > 0 && (
    <section class="glance wrap" aria-label="At a glance">
      <dl>
        {highlights.map((h) => (
          <div>
            <dt>{h.figure}</dt>
            <dd>{h.text}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .opening {
    display: grid;
    gap: 48px;
    padding-block: 56px 56px;
  }
  @media (min-width: 1000px) {
    .opening {
      grid-template-columns: minmax(0, 1fr) 420px;
      gap: 80px;
      padding-block: 88px 80px;
      align-items: center;
    }
  }
  h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.022em;
    line-height: 1.04;
    margin-top: 22px;
    max-width: 18ch;
  }
  .intro {
    font-family: var(--serif);
    font-size: clamp(1.18rem, 1.9vw, 1.36rem);
    line-height: 1.55;
    max-width: 46ch;
    margin-top: 28px;
    color: var(--text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .cv-note {
    margin-top: 12px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .elsewhere {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.92rem;
    max-width: 46ch;
  }
  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .elsewhere a:hover { color: var(--accent); }

  .photo { margin: 0; }
  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 18%;
    background: var(--paper-sunk);
  }
  .photo figcaption {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (max-width: 999px) {
    .photo { max-width: 520px; }
  }

  .glance dl {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 0 80px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 640px) {
    .glance dl { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .glance dl { grid-template-columns: repeat(4, 1fr); }
  }
  .glance div {
    padding: 22px 24px 24px 0;
  }
  .glance div + div { border-top: 1px solid var(--rule); }
  @media (min-width: 640px) {
    .glance div:nth-child(2) { border-top: 0; padding-left: 24px; border-left: 1px solid var(--rule); }
    .glance div:nth-child(4) { padding-left: 24px; border-left: 1px solid var(--rule); }
  }
  @media (min-width: 1000px) {
    .glance div + div { border-top: 0; padding-left: 24px; border-left: 1px solid var(--rule); }
  }
  .glance dt {
    font-family: var(--serif);
    font-size: 2.3rem;
    font-weight: 500;
    font-variation-settings: 'opsz' 48;
    color: var(--ink);
    line-height: 1;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.01em;
  }
  .glance dd {
    margin: 10px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    max-width: 28ch;
  }
</style>
