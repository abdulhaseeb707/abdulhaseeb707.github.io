---
// A flat map drawn at build time from Natural Earth borders (world-atlas). Plain SVG reaches the browser.
import { geoConicConformal, geoPath, geoDistance } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { highlights } from '../lib/profile';

const W = 1000;
const H = 560;
const places = {
  lahore: { name: 'Lahore', at: [74.3587, 31.5204] as [number, number] },
  krasnoyarsk: { name: 'Krasnoyarsk', at: [92.8932, 56.0153] as [number, number] },
  ekaterinburg: { name: 'Ekaterinburg', at: [60.6122, 56.8389] as [number, number] },
};
type Key = keyof typeof places;

const frame: [number, number][] = [];
for (let lon = 46; lon <= 106; lon += 2) frame.push([lon, 22], [lon, 62]);
for (let lat = 22; lat <= 62; lat += 2) frame.push([46, lat], [106, lat]);
const projection = geoConicConformal()
  .parallels([30, 60])
  .rotate([-76, 0])
  .fitExtent([[10, 10], [W - 10, H - 10]], { type: 'MultiPoint', coordinates: frame })
  .clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection).digits(0);
const topo = world as any;
const countries = (feature(topo, topo.objects.countries) as any).features
  .map((f: any) => ({ id: String(f.id), d: path(f) }))
  .filter((c: { d: string | null }) => c.d);

const xy = (k: Key) => projection(places[k].at)!;
const km = (a: Key, b: Key) => Math.round((geoDistance(places[a].at, places[b].at) * 6371) / 100) * 100;
function arc(a: Key, b: Key, bend: number) {
  const [x1, y1] = xy(a);
  const [x2, y2] = xy(b);
  const cx = (x1 + x2) / 2 - (y2 - y1) * bend;
  const cy = (y1 + y2) / 2 + (x2 - x1) * bend;
  return `M${x1.toFixed(0)},${y1.toFixed(0)} Q${cx.toFixed(0)},${cy.toFixed(0)} ${x2.toFixed(0)},${y2.toFixed(0)}`;
}

const at = (k: Key | 'online') => highlights.filter((h) => h.map === k);
const trips = (['krasnoyarsk', 'ekaterinburg'] as const)
  .filter((k) => at(k).length > 0)
  .map((k) => ({ key: k, d: arc('lahore', k, k === 'krasnoyarsk' ? 0.16 : -0.16), km: km('lahore', k) }));
const online = at('online');
const labels: { text: string; at: [number, number] }[] = [
  { text: 'RUSSIA', at: [80, 60.5] },
  { text: 'KAZAKHSTAN', at: [67, 48.3] },
  { text: 'CHINA', at: [94, 37] },
  { text: 'PAKISTAN', at: [66.6, 27.4] },
  { text: 'INDIA', at: [80, 24] },
];
---
<section class="wrap section places" id="places" aria-labelledby="places-title">
  <header class="section-head">
    <p class="kicker">Where I've been</p>
    <h2 id="places-title">From Lahore to Siberia, and back.</h2>
  </header>

  <figure class="map">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-desc">
      <desc id="map-desc">{trips.map((t) => `Lahore to ${places[t.key].name}, about ${t.km.toLocaleString('en')} km. `)}</desc>
      <rect width={W} height={H} class="sea" />
      <g class="land">
        {countries.map((c: { id: string; d: string }) => (
          <path d={c.d} class:list={{ pk: c.id === '586', ru: c.id === '643' }} />
        ))}
      </g>
      <g class="labels" aria-hidden="true">
        {labels.map((l) => {
          const p = projection(l.at);
          return p && <text x={p[0].toFixed(0)} y={p[1].toFixed(0)}>{l.text}</text>;
        })}
      </g>
      {trips.map((t) => <path d={t.d} class={`arc arc-${t.key}`} />)}
      {(Object.keys(places) as Key[]).map((k) => {
        const [x, y] = xy(k);
        const first = at(k)[0];
        const label = k === 'lahore' ? 'Lahore · home' : `${places[k].name} · ${first?.when ?? ''}`;
        const w = label.length * 13 + 28;
        // each label on its own side so they never overlap: Lahore below-right, Ekaterinburg above-left, Krasnoyarsk above-right
        const lx = k === 'ekaterinburg' ? Math.max(x - w - 6, 8) : Math.min(x + 14, W - w - 8);
        const ly = k === 'lahore' ? y + 18 : y - 52;
        return (
          (first || k === 'lahore') && (
            <a href={k === 'lahore' ? '#about' : `#hl-${first!.id}`} class={`pin pin-${k}`}>
              <circle cx={x.toFixed(0)} cy={y.toFixed(0)} r="11" class="dot" />
              <rect x={lx.toFixed(0)} y={ly.toFixed(0)} width={w} height="38" rx="19" class="chip" />
              <text x={(lx + w / 2).toFixed(0)} y={(ly + 25).toFixed(0)} text-anchor="middle" class="chip-text">{label}</text>
            </a>
          )
        );
      })}
    </svg>
    <figcaption>
      {trips.map((t) => <span class="tag sky">Lahore to {places[t.key].name}: about {t.km.toLocaleString('en')} km</span>)}
      {online.length > 0 && <span class="tag">Online: {online.map((h) => h.org).join(', ')}</span>}
    </figcaption>
  </figure>
</section>

<style>
  .map { margin: 0; }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .sea { fill: #e6f1fc; }
  .land path { fill: #efe9dd; stroke: var(--surface); stroke-width: 1.5; }
  .land path.pk { fill: var(--mint); }
  .land path.ru { fill: #fbe7a1; }
  .labels text { font: 500 16px var(--mono); letter-spacing: 0.16em; fill: #8b8b8b; text-anchor: middle; }
  .arc { fill: none; stroke: var(--coral-deep); stroke-width: 3.5; stroke-dasharray: 2 12; stroke-linecap: round; }
  .dot { fill: var(--yellow); stroke: var(--ink); stroke-width: 3; }
  .chip { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
  .chip-text { font: 600 19px var(--sans); fill: var(--ink); }
  .pin:hover .chip, .pin:focus-visible .chip { fill: var(--yellow); }
  .map:has(.pin-krasnoyarsk:hover) .arc-krasnoyarsk,
  .map:has(.pin-ekaterinburg:hover) .arc-ekaterinburg { stroke: var(--ink); }
  figcaption { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  figcaption .tag { white-space: normal; }
</style>
