---
// One shared viewer for photos and certificates. Any link with class "js-lightbox" opens in it.
// Without JS those links simply open the image.
import Icon from './Icon.astro';
---
<dialog class="lightbox" aria-label="Image viewer">
  <form method="dialog" class="close-form">
    <button class="close" aria-label="Close"><Icon name="close" /></button>
  </form>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.js-lightbox');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const thumb = link.querySelector('img');
    img.src = link.href;
    img.alt = thumb?.alt ?? link.dataset.caption ?? '';
    caption.textContent = link.dataset.caption ?? '';
    dialog.showModal();
  });

  // click on the dark area closes
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => img.removeAttribute('src'));
</script>

<style>
  .lightbox {
    width: min(100vw - 24px, 1100px);
    max-height: calc(100vh - 24px);
    padding: 0;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--text);
  }
  .lightbox::backdrop { background: rgb(10 14 22 / 0.86); }
  figure {
    margin: 0;
    padding: 16px 16px 18px;
  }
  img {
    width: 100%;
    max-height: calc(100vh - 140px);
    object-fit: contain;
    background: var(--paper-sunk);
  }
  figcaption {
    margin-top: 12px;
    padding-right: 48px;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--muted);
  }
  .close-form {
    position: absolute;
    right: 8px;
    bottom: 8px;
  }
  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .close:hover { background: var(--paper-sunk); }
</style>
