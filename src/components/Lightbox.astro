---
// One shared viewer for photos and certificates. Any link with class "js-lightbox" opens in it;
// links sharing a data-gallery value can be flipped through. Without JS the links just open the image.
import Icon from './Icon.astro';
---
<dialog class="lightbox" aria-label="Photo viewer">
  <figure>
    <img alt="" />
    <figcaption>
      <span class="caption"></span>
      <span class="position"></span>
    </figcaption>
  </figure>
  <div class="controls">
    <button class="prev" type="button" aria-label="Previous photo"><Icon name="arrow-left" /></button>
    <button class="next" type="button" aria-label="Next photo"><Icon name="arrow-right" /></button>
    <form method="dialog"><button class="close" aria-label="Close"><Icon name="close" /></button></form>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('.caption')!;
  const position = dialog.querySelector('.position')!;
  const prev = dialog.querySelector<HTMLButtonElement>('.prev')!;
  const next = dialog.querySelector<HTMLButtonElement>('.next')!;
  let items: HTMLAnchorElement[] = [];
  let index = 0;

  const show = (i: number) => {
    index = (i + items.length) % items.length;
    const link = items[index];
    const thumb = link.querySelector('img');
    img.src = link.href;
    img.alt = thumb?.alt ?? link.dataset.caption ?? '';
    caption.textContent = link.dataset.caption ?? '';
    position.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
    prev.hidden = next.hidden = items.length < 2;
  };

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.js-lightbox');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const group = link.dataset.gallery;
    items = group ? [...document.querySelectorAll<HTMLAnchorElement>(`a.js-lightbox[data-gallery="${group}"]`)] : [link];
    show(items.indexOf(link));
    dialog.showModal();
  });
  prev.addEventListener('click', () => show(index - 1));
  next.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('close', () => img.removeAttribute('src'));
</script>

<style>
  .lightbox {
    width: min(100vw - 24px, 1080px);
    max-height: calc(100vh - 24px);
    padding: 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  .lightbox::backdrop { background: rgb(20 20 20 / 0.82); }
  img {
    width: 100%;
    max-height: calc(100vh - 150px);
    object-fit: contain;
    border-radius: 10px;
    background: var(--paper);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    padding-right: 160px;
    font-size: 0.95rem;
  }
  .position { font: 400 0.85rem/1.4 var(--mono); color: var(--muted); white-space: nowrap; }
  .controls {
    position: absolute;
    right: 14px;
    bottom: 12px;
    display: flex;
    gap: 8px;
  }
  .controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .controls button:hover { background: var(--yellow); }
  .controls form { margin: 0; }
  @media (max-width: 560px) {
    figcaption { flex-direction: column; gap: 4px; padding-right: 0; padding-bottom: 54px; }
  }
</style>
