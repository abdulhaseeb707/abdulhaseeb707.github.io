---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { research as r, site, asset } from '../lib/profile';

// the slider explainer: piecewise-linear fitted shape from the paper's threshold model
const { at, below, above, from, to } = r.kink;
const W = 320;
const H = 170;
const pad = { l: 34, r: 12, t: 14, b: 30 };
const yAt = (x: number) => below * (Math.min(x, at) - from) + above * Math.max(x - at, 0);
const yMax = Math.max(yAt(at), yAt(to)) * 1.15;
const sx = (x: number) => pad.l + ((x - from) / (to - from)) * (W - pad.l - pad.r);
const sy = (y: number) => H - pad.b - (y / yMax) * (H - pad.t - pad.b);
const line = [from, at, to].map((x) => `${sx(x).toFixed(1)},${sy(yAt(x)).toFixed(1)}`).join(' ');
---
<section class="block-green" id="research" aria-labelledby="research-title">
  <div class="wrap section research">
    <div class="top">
      <div>
        <p class="kicker">My research</p>
        <h2 id="research-title">{r.title}</h2>
        <p class="lead">{r.tagline}</p>
        <p class="status">{r.status}</p>
      </div>
      <dl class="stats">
        {r.stats.map((s) => (
          <div>
            <dt>{s.figure}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="middle">
      <div class="card figures">
        <div class="tabs" role="tablist" aria-label="Charts from the paper" hidden>
          {r.figures.map((f, i) => (
            <button type="button" role="tab" id={`tab-${i}`} aria-controls={`fig-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              {f.tab}
            </button>
          ))}
        </div>
        {r.figures.map((f, i) => (
          <figure class="panel" id={`fig-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`}>
            <Image src={asset(f.src)} alt={f.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 720px, 92vw" />
            <figcaption>{f.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div class="card kink" data-kink={JSON.stringify(r.kink)}>
        <h3>Slide the inflation rate</h3>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Fitted return on assets rises by ${below} points per point of inflation up to ${at}%, then is flat.`}>
          <line class="axis" x1={pad.l} y1={H - pad.b} x2={W - pad.r} y2={H - pad.b} />
          <line class="axis" x1={pad.l} y1={pad.t} x2={pad.l} y2={H - pad.b} />
          <line class="kink-line" x1={sx(at)} y1={pad.t} x2={sx(at)} y2={H - pad.b} />
          <text class="tick" x={sx(at)} y={H - 10} text-anchor="middle">{at}%</text>
          <text class="tick" x={sx(from)} y={H - 10} text-anchor="middle">{from}%</text>
          <text class="tick" x={sx(to)} y={H - 10} text-anchor="middle">{to}%</text>
          <text class="tick" x="6" y={pad.t + 8}>ROA</text>
          <polyline class="curve" points={line} />
          <circle class="dot" cx={sx(8)} cy={sy(yAt(8))} r="7" />
        </svg>
        <label class="slider">
          <span class="visually-hidden">Inflation rate</span>
          <input type="range" min={from} max={to} step="0.5" value="8" />
        </label>
        <p class="readout" aria-live="polite">
          At <strong data-x>8%</strong> inflation, one more point goes with <strong data-slope>+{below.toFixed(2)} pp</strong> of return on assets.
        </p>
        <p class="note">From the paper's threshold model. These are associations, not causes.</p>
      </div>
    </div>

    <ol class="findings">
      {r.findings.map((f) => (
        <li>
          <span class="big">{f.figure}</span>
          <span>{f.text}</span>
        </li>
      ))}
    </ol>

    <div class="bottom">
      <p class="origin">{r.origin}</p>
      <ul class="links">
        {r.links.map((l, i) => (
          <li>
            <a class:list={['btn', i === 0 ? 'btn-yellow' : 'btn-clear']} href={l.url} target="_blank" rel="noopener">
              {l.label} {l.note && <span class="note-small">{l.note}</span>}
            </a>
          </li>
        ))}
        <li>
          <a class="btn btn-clear" href={site.researchPage}>All the details <Icon name="arrow-right" /></a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  // chart tabs
  const tablist = document.querySelector<HTMLElement>('.figures [role="tablist"]');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
    };
    tablist.hidden = false;
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const n = (i + step + tabs.length) % tabs.length;
        select(n);
        tabs[n].focus();
      });
    });
  }

  // the slider explainer
  const box = document.querySelector<HTMLElement>('.kink');
  if (box) {
    const k = JSON.parse(box.dataset.kink!);
    const input = box.querySelector('input')!;
    const dot = box.querySelector<SVGCircleElement>('.dot')!;
    const xOut = box.querySelector('[data-x]')!;
    const slopeOut = box.querySelector('[data-slope]')!;
    const W = 320, H = 170, pad = { l: 34, r: 12, t: 14, b: 30 };
    const yAt = (x: number) => k.below * (Math.min(x, k.at) - k.from) + k.above * Math.max(x - k.at, 0);
    const yMax = Math.max(yAt(k.at), yAt(k.to)) * 1.15;
    const sx = (x: number) => pad.l + ((x - k.from) / (k.to - k.from)) * (W - pad.l - pad.r);
    const sy = (y: number) => H - pad.b - (y / yMax) * (H - pad.t - pad.b);
    const fmt = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toFixed(2) + ' pp';
    const update = () => {
      const x = Number(input.value);
      dot.setAttribute('cx', sx(x).toFixed(1));
      dot.setAttribute('cy', sy(yAt(x)).toFixed(1));
      xOut.textContent = `${x}%`;
      const slope = x < k.at ? k.below : k.above;
      slopeOut.textContent = slope === k.above ? `${fmt(slope)}, basically flat` : fmt(slope);
      box.classList.toggle('past-kink', x >= k.at);
    };
    input.addEventListener('input', update);
    update();
  }
</script>

<style>
  .research { display: grid; gap: clamp(28px, 4vw, 48px); }
  .top {
    display: grid;
    gap: 28px;
    align-items: end;
  }
  @media (min-width: 1000px) {
    .top { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 56px; }
  }
  h2 { max-width: 20ch; }
  .lead { margin-top: 16px; max-width: 46ch; opacity: 0.92; }
  .status {
    display: inline-block;
    margin-top: 18px;
    padding: 5px 12px;
    border: 1.5px solid currentColor;
    border-radius: var(--pill);
    font: 500 0.8rem/1.2 var(--mono);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }
  .stats div {
    padding: 16px 18px;
    border: 2px solid var(--surface);
    border-radius: var(--radius-sm);
  }
  .stats dt {
    font: 800 clamp(1.8rem, min(3.4vw, 6vh), 2.7rem)/1 var(--display);
    letter-spacing: -0.03em;
  }
  .stats dd { margin: 6px 0 0; font: 500 0.82rem/1.2 var(--mono); opacity: 0.9; }

  .middle {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 1000px) {
    .middle { grid-template-columns: minmax(0, 1.75fr) minmax(300px, 1fr); }
  }
  .card {
    padding: clamp(14px, 2vw, 22px);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .tabs button {
    padding: 7px 14px;
    border: 2px solid var(--ink);
    border-radius: var(--pill);
    background: var(--surface);
    font: 600 0.85rem/1.2 var(--sans);
    cursor: pointer;
  }
  .tabs button:hover { background: var(--mint); }
  .tabs button[aria-selected='true'] { background: var(--ink); color: var(--surface); }
  .panel + .panel { margin-top: 18px; }
  :global(.js) .panel + .panel { margin-top: 0; }
  .panel img { width: 100%; border-radius: 8px; background: #fcfcfb; }
  .panel figcaption { margin-top: 10px; font-size: 0.9rem; color: var(--ink-soft); }

  .kink h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .kink svg { display: block; width: 100%; height: auto; }
  .axis { stroke: var(--ink); stroke-width: 1.5; }
  .kink-line { stroke: var(--coral-deep); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .tick { font: 400 11px var(--mono); fill: var(--muted); }
  .curve { fill: none; stroke: var(--green); stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; }
  .dot { fill: var(--yellow); stroke: var(--ink); stroke-width: 2.5; transition: cx 0.1s, cy 0.1s; }
  .past-kink .dot { fill: var(--coral); }
  .slider input { width: 100%; margin: 12px 0 8px; accent-color: var(--green); }
  .readout { font-size: 0.98rem; }
  .readout strong { font-family: var(--mono); font-weight: 500; }
  .note { margin-top: 8px; font: 400 0.78rem/1.4 var(--mono); color: var(--muted); }

  .findings {
    list-style: none;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .findings li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 18px 20px 20px;
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .findings li:nth-child(2) { background: var(--yellow); }
  .findings li:nth-child(3) { background: var(--sky); }
  .findings li:nth-child(4) { background: var(--mint); }
  .big {
    font: 800 clamp(1.7rem, min(3vw, 5.4vh), 2.4rem)/1 var(--display);
    letter-spacing: -0.03em;
  }

  .bottom { display: grid; gap: 18px; }
  .origin { font-size: 0.98rem; opacity: 0.92; max-width: 60ch; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; }
  .links .btn-yellow { color: var(--ink); border-color: var(--ink); }
  .note-small { font: 400 0.75rem/1 var(--mono); opacity: 0.75; }
</style>
