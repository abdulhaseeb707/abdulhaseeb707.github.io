---
// A flat, printed-style map drawn at build time from Natural Earth borders (world-atlas).
// No map library reaches the browser: the output is plain SVG paths.
import { geoConicConformal, geoPath, geoDistance } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { timeline, type Chapter } from '../lib/profile';

const W = 1000;
const H = 620;

const places = {
  lahore: { name: 'Lahore', country: 'Pakistan', at: [74.3587, 31.5204] as [number, number] },
  krasnoyarsk: { name: 'Krasnoyarsk', country: 'Russia', at: [92.8932, 56.0153] as [number, number] },
  ekaterinburg: { name: 'Ekaterinburg', country: 'Russia', at: [60.6122, 56.8389] as [number, number] },
};
type PlaceKey = keyof typeof places;

// frame the region from the Caspian to Lake Baikal, Lahore to the Arctic edge
const frame: [number, number][] = [];
for (let lon = 46; lon <= 106; lon += 2) frame.push([lon, 21], [lon, 63]);
for (let lat = 21; lat <= 63; lat += 2) frame.push([46, lat], [106, lat]);

const projection = geoConicConformal()
  .parallels([30, 60])
  .rotate([-76, 0])
  .fitExtent([[10, 10], [W - 10, H - 10]], { type: 'MultiPoint', coordinates: frame })
  .clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection).digits(0);

const topo = world as any;
const countries = (feature(topo, topo.objects.countries) as any).features
  .map((f: any) => ({ id: String(f.id), d: path(f) }))
  .filter((c: { d: string | null }) => c.d);
const focus = new Set(['586', '643']); // Pakistan, Russia

const xy = (key: PlaceKey) => projection(places[key].at)!;
const km = (a: PlaceKey, b: PlaceKey) =>
  Math.round((geoDistance(places[a].at, places[b].at) * 6371) / 100) * 100;

// a gentle curve between two pins, bowed to one side
function arc(a: PlaceKey, b: PlaceKey, bend: number) {
  const [x1, y1] = xy(a);
  const [x2, y2] = xy(b);
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const cx = mx - dy * bend;
  const cy = my + dx * bend;
  return `M${x1.toFixed(1)},${y1.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
}

const at = (key: PlaceKey) => timeline.filter((c) => c.map === key);
const online = timeline.filter((c) => c.map === 'online');
const years = (cs: Chapter[]) => [...new Set(cs.map((c) => c.date.slice(0, 4)))].join(', ');

const trips = (['krasnoyarsk', 'ekaterinburg'] as const)
  .filter((key) => at(key).length > 0)
  .map((key) => ({ key, d: arc('lahore', key, key === 'krasnoyarsk' ? 0.16 : -0.16), distance: km('lahore', key) }));

const words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const count = (n: number) => words[n] ?? String(n);
const abroad = trips.reduce((n, t) => n + at(t.key).length, 0);

const labels: { text: string; at: [number, number] }[] = [
  { text: 'RUSSIA', at: [77, 61] },
  { text: 'KAZAKHSTAN', at: [67, 48.3] },
  { text: 'CHINA', at: [93, 37] },
  { text: 'MONGOLIA', at: [101, 46.6] },
  { text: 'PAKISTAN', at: [66.5, 27.2] },
  { text: 'INDIA', at: [80, 23.5] },
  { text: 'IRAN', at: [55, 31] },
];
---
<section class="section journey" id="journey" aria-labelledby="journey-title">
  <div class="wrap">
    <header class="section-head">
      <p class="label kicker">Where it happened</p>
      <h2 id="journey-title">From Lahore, and back again</h2>
      <p>
        Most of my story happened in Lahore. {count(abroad)[0].toUpperCase() + count(abroad).slice(1)} chapters took me to Russia, and
        {count(online.length)} happened online. Tap a city to jump to its chapter.
      </p>
    </header>

    <div class="journey-layout">
      <figure class="map">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
          <title id="map-title">Map of my journeys from Lahore</title>
          <desc id="map-desc">
            {trips.map((t) => `Lahore to ${places[t.key].name}, about ${t.distance.toLocaleString('en')} kilometres. `)}
          </desc>
          <rect width={W} height={H} class="sea" />
          <g class="land">
            {countries.map((c: { id: string; d: string }) => <path d={c.d} class:list={{ focus: focus.has(c.id) }} />)}
          </g>
          <g class="country-labels" aria-hidden="true">
            {labels.map((l) => {
              const p = projection(l.at);
              return p && <text x={p[0].toFixed(0)} y={p[1].toFixed(0)}>{l.text}</text>;
            })}
          </g>
          <g class="arcs">
            {trips.map((t) => <path d={t.d} class={`arc arc-${t.key}`} />)}
          </g>
          {(Object.keys(places) as PlaceKey[]).map((key) => {
            const [x, y] = xy(key);
            const first = at(key)[0];
            const below = key === 'lahore';
            return (
              first && (
                <a href={`#ch-${first.id}`} class={`pin pin-${key}`}>
                  <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="22" class="hit" />
                  <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="8" class="dot" />
                  <text x={(x + 16).toFixed(1)} y={(below ? y + 30 : y - 14).toFixed(1)} class="pin-name">
                    {places[key].name}
                  </text>
                  <text x={(x + 16).toFixed(1)} y={(below ? y + 56 : y + 12).toFixed(1)} class="pin-year">
                    {key === 'lahore' ? 'home' : years(at(key))}
                  </text>
                </a>
              )
            );
          })}
        </svg>
        <figcaption>Borders: Natural Earth. Distances are straight-line.</figcaption>
      </figure>

      <ol class="places">
        <li>
          <p class="label">Home</p>
          <h3>Lahore, Pakistan</h3>
          <p>{at('lahore').map((c, i) => <>{i > 0 && ', '}<a href={`#ch-${c.id}`}>{c.title}</a></>)}</p>
        </li>
        {trips.map((t) => (
          <li>
            <p class="label">{years(at(t.key))} · about {t.distance.toLocaleString('en')} km</p>
            <h3>{places[t.key].name}, {places[t.key].country}</h3>
            <p>{at(t.key).map((c) => <a href={`#ch-${c.id}`}>{c.title}</a>)}</p>
          </li>
        ))}
        {online.length > 0 && (
          <li>
            <p class="label">Online</p>
            <h3>From my desk</h3>
            <p>{online.map((c, i) => <>{i > 0 && ', '}<a href={`#ch-${c.id}`}>{c.title}</a></>)}</p>
          </li>
        )}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey-layout {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .journey-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; align-items: start; }
  }
  .map { margin: 0; }
  svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .sea { fill: var(--paper); }
  .land path {
    fill: var(--land);
    stroke: var(--paper);
    stroke-width: 1;
  }
  .land path.focus { fill: var(--land-focus); }
  .country-labels text {
    font: 600 15px var(--sans);
    letter-spacing: 0.18em;
    fill: var(--muted);
    opacity: 0.75;
    text-anchor: middle;
  }
  .arc {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 7 7;
    stroke-linecap: round;
    transition: stroke 0.2s ease;
  }
  .pin { cursor: pointer; }
  .hit { fill: transparent; }
  .dot {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 3;
  }
  .pin-name {
    font: 600 26px var(--serif);
    fill: var(--ink);
  }
  .pin-year {
    font: 500 19px var(--sans);
    fill: var(--muted);
  }
  .pin:hover .pin-name,
  .pin:focus-visible .pin-name { fill: var(--accent); text-decoration: underline; }
  .pin:hover .dot { r: 11; }
  /* hovering a city lights up the trip that took me there */
  .map:has(.pin-krasnoyarsk:hover, .pin-krasnoyarsk:focus-visible) .arc-krasnoyarsk,
  .map:has(.pin-ekaterinburg:hover, .pin-ekaterinburg:focus-visible) .arc-ekaterinburg {
    stroke: var(--accent);
    stroke-width: 3;
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .places {
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 2px solid var(--ink);
  }
  .places li {
    padding: 16px 0 18px;
    border-bottom: 1px solid var(--rule);
  }
  .places h3 {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 4px 0 6px;
  }
  .places p { font-size: 0.95rem; }
  .places p a { display: inline; }
  .places li:nth-child(2) p a,
  .places li:nth-child(3) p a { display: block; }
</style>
